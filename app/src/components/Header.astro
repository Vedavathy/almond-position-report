---
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/archive', label: 'Archive' },
  { href: '/generate', label: 'Generate Report' },
];
---

<header class="border-b border-border bg-card/80 backdrop-blur-sm sticky top-0 z-50">
  <nav class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <a href="/" class="font-semibold text-lg tracking-tight">
      Almond Position Report
    </a>
    <ul class="flex items-center gap-6 text-sm font-medium">
      {navItems.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'transition-colors hover:text-primary',
              currentPath === href || (href !== '/' && currentPath.startsWith(href))
                ? 'text-primary'
                : 'text-secondary',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
