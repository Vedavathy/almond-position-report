---
interface Props {
  label: string;
  value: string;
  subtext?: string;
  change?: number | null;
}

const { label, value, subtext, change } = Astro.props;
---

<div class="bg-card border border-border rounded-lg p-5">
  <p class="text-xs font-medium text-secondary uppercase tracking-wider">{label}</p>
  <p class="text-2xl font-bold mt-1 tabular-nums">{value}</p>
  {subtext && <p class="text-xs text-secondary mt-1">{subtext}</p>}
  {change !== undefined && change !== null && (
    <p class:list={[
      'text-sm font-semibold mt-1 tabular-nums',
      change > 0 ? 'text-positive' : change < 0 ? 'text-negative' : 'text-secondary',
    ]}>
      {change > 0 ? '+' : ''}{change.toFixed(1)}% YOY
    </p>
  )}
</div>
